---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/#work',  label: 'Work'   },
  { href: '/about',  label: 'About'  },
  // Studio isn't ready yet — remove `hidden: true` to bring it back.
  { href: '/studio', label: 'Studio', hidden: true },
].filter(link => !link.hidden);

function isActive(href: string, current: string): boolean {
  if (href === '/#work') return current === '/';
  return current.startsWith(href);
}
---

<nav id="site-nav" aria-label="Main navigation">
  <a href="/" class="wordmark" aria-label="TemperedPixel home">
    Tempered<span>Pixel</span>
  </a>
  <ul role="list">
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class:list={['nav-link', { active: isActive(link.href, currentPath) }]}
          aria-current={isActive(link.href, currentPath) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function initNav() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const update = () => nav.classList.toggle('scrolled', window.scrollY > 40);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Runs on initial load and after every View Transition navigation
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 48px;
    box-shadow: inset 0 -1px 0 transparent;
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }

  nav.scrolled {
    background: rgba(17, 17, 20, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 -1px 0 var(--border);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark span { color: var(--accent); }

  ul {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover { color: var(--text); }
  .nav-link.active { color: var(--accent); }

  /* Tablet */
  @media (max-width: 1024px) {
    nav { padding: 18px 32px; }
  }

  /* Mobile */
  @media (max-width: 640px) {
    nav { padding: 16px 20px; }
    ul { gap: 16px; }
    .nav-link { font-size: 9px; letter-spacing: 1.5px; }
  }
</style>
