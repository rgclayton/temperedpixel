---
interface Props {
  slug: string;
  title: string;
  type: 'engineering' | 'design';
  summary: string;
  tags: string[];
  placeholder?: boolean;
  featured?: boolean;
  size?: 'normal' | 'wide' | 'tall' | 'large';
  image?: string;
  // Per-breakpoint overrides. Optional — see content.config.ts.
  tabletSize?: 'normal' | 'wide' | 'tall' | 'large';
  desktopOrder?: number;
  tabletOrder?: number;
}

const {
  slug,
  title,
  type,
  summary,
  tags,
  placeholder = false,
  featured = false,
  size = 'normal',
  image,
  tabletSize,
  desktopOrder,
  tabletOrder,
} = Astro.props;
---

<a
  href={placeholder ? undefined : `/work/${slug}`}
  class:list={['card', `size-${size}`, tabletSize && `tablet-size-${tabletSize}`, { featured, placeholder, 'has-image': !!image }]}
  aria-label={placeholder ? `${title} — coming soon` : `View ${title} project`}
  tabindex={placeholder ? -1 : 0}
  style={`view-transition-name: card-${slug}; --desktop-order: ${desktopOrder ?? 0}; --tablet-order: ${tabletOrder ?? 0};`}
>
  {image && <div class="card-bg" style={`background-image: url('${image}')`} />}
  <div class="card-inner">
    <p class="card-type">{type === 'engineering' ? 'Engineering' : 'Design'}{placeholder ? ' · Coming soon' : ''}</p>
    <h2 class="card-title" style={`view-transition-name: title-${slug}`}>{title}</h2>
    <p class="card-desc">{summary}</p>
    {tags.length > 0 && (
      <ul class="tags" role="list">
        {tags.map(tag => <li class="tag">{tag}</li>)}
      </ul>
    )}
  </div>
  {!placeholder && <span class="arrow" aria-hidden="true">→</span>}
</a>

<style>
  .card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 22px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .card:not(.placeholder):hover {
    border-color: rgba(162, 89, 255, 0.4);
    background: var(--bg-card-hover);
  }

  .card:not(.placeholder):hover .arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .card.featured {
    border-color: var(--border-accent);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
  }

  .card.featured:hover { border-color: rgba(162, 89, 255, 0.55); }

  .card.placeholder {
    border: 1px dashed var(--border-placeholder);
    background: var(--bg-card-placeholder);
    cursor: default;
  }

  .card-inner { flex: 1; position: relative; z-index: 1; }

  /* Full-bleed background photo, only rendered when `image` is set.
     Without it, the card just keeps the plain --bg-card look above. */
  .card-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: left;
    transition: transform 0.5s ease;
  }

  .card:hover .card-bg { transform: scale(1.14); }

  /* Scrim for legibility over an arbitrary photo. Hardcoded, not theme
     tokens — same as Hero.astro's scrim, since this must work regardless
     of light/dark site theme. */
  .card-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(17, 17, 20, 0.72);
  }

  .card.has-image .card-type  { color: #a259ff; }
  .card.has-image .card-title { color: #ffffff; }
  .card.has-image .card-desc  { color: rgba(255, 255, 255, 0.7); }

  .card.has-image .tag {
    background: rgba(17, 17, 20, 0.5);
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.8);
  }

  .card.has-image .arrow { color: #a259ff; }

  .card-type {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .placeholder .card-type { color: var(--text-placeholder); }

  .card-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .featured .card-title { font-size: 24px; }
  .placeholder .card-title { color: var(--text-placeholder); }

  .card-desc {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .placeholder .card-desc { color: var(--border-placeholder); }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    margin-top: 14px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 2px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-dim);
  }

  .arrow {
    position: absolute;
    bottom: 16px; right: 16px;
    z-index: 1;
    width: 28px; height: 28px;
    border: 1px solid rgba(162, 89, 255, 0.3);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    color: var(--accent);
    opacity: 0;
    transform: translate(4px, 4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  /* Arrow only shows on hover-capable devices */
  @media (hover: none) {
    .arrow { display: none; }
  }

  /* Bento grid spans. Named presets, not raw column/row numbers, so
     authors pick a size rather than a coordinate. */
  .size-wide  { grid-column: span 2; }
  .size-tall  { grid-row: span 2; }
  .size-large { grid-column: span 2; grid-row: span 2; }

  /* Tablet-only size override, from `tabletSize` — same 4 presets as
     `size`, just for this one breakpoint. Visual order for this and
     desktop is handled in ProjectGrid.astro's script, not CSS `order`
     (that only moves things visually, not in tab order). */
  @media (min-width: 641px) and (max-width: 1024px) {
    .tablet-size-normal { grid-column: span 1; grid-row: span 1; }
    .tablet-size-wide   { grid-column: span 2; grid-row: span 1; }
    .tablet-size-tall   { grid-column: span 1; grid-row: span 2; }
    .tablet-size-large  { grid-column: span 2; grid-row: span 2; }
  }

  /* Mobile is a single column — reset every span so cards stack plainly
     instead of leaving gaps. */
  @media (max-width: 640px) {
    .size-wide,
    .size-tall,
    .size-large {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
