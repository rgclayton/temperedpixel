---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props:  { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, type, summary, year, role, tags, github, live, placeholder } = project.data;

// Next project navigation
const all = await getCollection('projects');
const sorted = all.sort((a, b) => a.data.order - b.data.order);
const idx = sorted.findIndex(p => p.id === project.id);
const next = sorted[(idx + 1) % sorted.length];
---

<Base title={title} description={summary}>
  <article class="detail" style={`view-transition-name: card-${project.id}`}>

    <a href="/#work" class="back">← Work</a>

    <header class="detail-header">
      <p class="detail-type">{type === 'engineering' ? 'Engineering' : 'Design'}</p>
      <h1 class="detail-title" style={`view-transition-name: title-${project.id}`}>
        {title}
      </h1>
      <div class="detail-meta">
        {year && <span class="meta-item">{year}</span>}
        {role && <span class="meta-item">{role}</span>}
      </div>
      {tags.length > 0 && (
        <ul class="detail-tags" role="list">
          {tags.map(tag => <li class="tag">{tag}</li>)}
        </ul>
      )}
    </header>

    {placeholder ? (
      <div class="placeholder-body">
        <p>This project is coming soon. Check back later.</p>
      </div>
    ) : (
      <div class="prose">
        <Content />
      </div>
    )}

    <div class="detail-links">
      {github && <a href={github} class="detail-link" target="_blank" rel="noopener noreferrer">GitHub →</a>}
      {live   && <a href={live}   class="detail-link" target="_blank" rel="noopener noreferrer">Live site →</a>}
    </div>

    {next && !next.data.placeholder && (
      <nav class="next-project" aria-label="Next project">
        <span class="next-label">Next</span>
        <a href={`/work/${next.id}`} class="next-link">{next.data.title} →</a>
      </nav>
    )}

  </article>
</Base>

<style>
  .detail {
    max-width: 760px;
    margin: 0 auto;
    padding: 120px 48px 80px;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 48px;
    transition: color 0.2s;
  }

  .back:hover { color: var(--accent); }

  .detail-type {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .detail-meta {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
  }

  .meta-item {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--text-dim);
  }

  .detail-tags {
    display: flex; flex-wrap: wrap; gap: 4px;
    list-style: none; margin-bottom: 48px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 8px; letter-spacing: 1px; text-transform: uppercase;
    padding: 3px 7px; border-radius: 2px;
    background: var(--bg-card); border: 1px solid var(--border);
    color: var(--text-dim);
  }

  .prose {
    font-family: var(--font-longform);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 900;
    color: var(--text);
    margin: 48px 0 16px;
  }

  .prose :global(p) { margin-bottom: 20px; }

  .prose :global(strong) { color: var(--text); font-weight: 600; }

  .prose :global(img),
  .prose :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--border);
    margin: 32px 0;
  }

  .placeholder-body {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-dim);
    padding: 48px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 48px 0;
  }

  .detail-links {
    display: flex; gap: 20px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .detail-link {
    font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--accent); text-decoration: none;
    transition: color 0.2s;
  }

  .detail-link:hover { color: var(--text); }

  .next-project {
    display: flex; align-items: center; gap: 16px;
    margin-top: 64px; padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .next-label {
    font-family: var(--font-mono);
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--text-dim);
  }

  .next-link {
    font-family: var(--font-display);
    font-size: 18px; font-weight: 800;
    color: var(--text); text-decoration: none;
    transition: color 0.2s;
  }

  .next-link:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .detail { padding: 100px 20px 60px; }
  }
</style>
